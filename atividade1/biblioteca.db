create database Biblioteca;
show databases;
use Biblioteca;

create table autor
(
	id_autor INT primary key,
    nome varchar(100) not null,
    nacinalidade varchar(50)
    
);

create table livro
(
	id_autor INT not null,
	id_livro INT not null,
    titulo varchar(150) not null,
    ano INT,
    editora varchar(80),
    
    primary key (id_autor, id_livro),
    foreign key (id_autor) references autor(id_autor) on delete cascade on update cascade
    
);

create table aluno
(
	id_aluno INT primary key,
    nome varchar(100) not null,
    email varchar(100) unique ,
    curso varchar(50)
    
);

ALTER TABLE aluno ADD telefone INT not null;

ALTER TABLE livro ADD isbn varchar(13) unique not null;

ALTER TABLE livro MODIFY COLUMN editora varchar(120);

ALTER TABLE livro CHANGE COLUMN ano ano_publicação INT CHECK (quantidade >= 1);

ALTER TABLE aluno DROP COLUMN telefone;

DESCRIBE aluno;
DESCRIBE disciplina;
DESCRIBE matriculado;

DROP TABLE aluno;

DROP TABLE livro;

DROP database if exists Biblioteca;
